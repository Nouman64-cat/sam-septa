# Database
DATABASE_URL=postgresql://your_db_username:your_db_password@localhost:5432/your_db_name
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=your_db_name
POSTGRESQL_USERNAME=your_db_username
POSTGRESQL_PASSWORD=your_db_password

# SEPTA Portal Credentials
SEPTA_USERNAME=your_septa_username
SEPTA_PASSWORD=your_septa_password

# Unison Marketplace Credentials
UNISON_EMAIL=your_email@example.com
UNISON_PASSWORD=your_password

# AWS S3 — stores exported Excel files under exports/
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Email notifications — sent to all addresses in RECIPIENT_EMAILS when a scrape completes
RECIPIENT_EMAILS=email1@example.com,email2@example.com

# AWS SES SMTP — obtain these from AWS Console → SES → SMTP Settings → Create SMTP Credentials
AWS_SES_FROM_EMAIL=no-reply@yourdomain.com
AWS_SES_USERNAME=your_ses_smtp_username
AWS_SES_PASSWORD=your_ses_smtp_password
